{
  "name": "MediSpark BD — Academic & Admission Care",
  "short_name": "MediSpark",
  "description": "Courses, exams and guidelines for Academic & Admission — all in one platform.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "dir": "ltr",
  "lang": "en",
  "background_color": "#0b1220",
  "theme_color": "#0b1220",
  "categories": ["education"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://medisparkbd.com/manifest.webmanifest"
    },
    {
      "platform": "webapp",
      "url": "https://medisparkbd.com/?source=pwa"
    }
  ],
  "launch_handler": {
    "route_to": "auto",
    "navigate_existing_client": "always"
  },
  "icons": [
    {
      "src": "/icons/icon-192-v2.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192-v2.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
